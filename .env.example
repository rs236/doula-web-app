# -----------------------------------------------------------------------------
# CLIENT-SIDE ENVIRONMENT VARIABLES (Vite - exposed to browser bundle)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_RAZORPAY_KEY_ID=rzp_test_...

# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY ENVIRONMENT VARIABLES (Vercel Serverless Functions)
# NEVER add VITE_ prefix to these! Keep private in Vercel project settings.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional PayPal Credentials (if using PayPal mode)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
